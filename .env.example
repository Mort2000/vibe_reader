# Copy to .env and fill in values. Loaded automatically by pytest (conftest.py).
# Existing shell environment variables take precedence over .env entries.

# --- Backend (start app with these for system verification) ---
VIBE_READER_DATA_DIR=/tmp/vibe_reader_verify
VIBE_READER_VERIFY_MODE=1

# LLM provider (required for scenarios that call the model)
VIBE_READER_LLM_BASE_URL=
VIBE_READER_LLM_API_KEY=
VIBE_READER_LLM_MODEL=deepseek-v4-flash

# --- Verification framework (vibe-verify / pytest) ---
# VIBE_READER_VERIFY_CONFIG=tests/corpus/verify.toml
VIBE_READER_VERIFY_TARGET_URL=http://127.0.0.1:8000
VIBE_READER_VERIFY_DATA_DIR=/tmp/vibe_reader_verify
# VIBE_READER_VERIFY_SUITE=smoke
# VIBE_READER_VERIFY_RUN_ID=

# --- Optional observability ---
# VIBE_READER_OBSERVABILITY_ENABLED=1
# VIBE_READER_LOG_LEVEL=INFO
# VIBE_READER_OTEL_ENDPOINT=
