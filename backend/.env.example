# Copy to backend/.env and source it before manual backend runs when needed.
# Existing shell environment variables take precedence over .env entries.

# --- Backend ---
VIBE_READER_DATA_DIR=/tmp/vibe_reader

# LLM provider
VIBE_READER_LLM_BASE_URL=
VIBE_READER_LLM_API_KEY=
VIBE_READER_LLM_MODEL=deepseek-v4-flash

# Enable only when the independent verify/ project needs temporary
# /api/verify/* compatibility endpoints against this backend.
# VIBE_READER_VERIFY_MODE=1

# --- Optional observability ---
# VIBE_READER_OBSERVABILITY_ENABLED=1
# VIBE_READER_LOG_LEVEL=INFO
# VIBE_READER_OTEL_ENDPOINT=
